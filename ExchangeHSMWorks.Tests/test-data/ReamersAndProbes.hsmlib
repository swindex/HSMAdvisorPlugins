<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<tool-library xmlns="http://www.hsmworks.com/xml/2004/cnc/tool-library" version="1.0">

  <tool guid="A1B2C3D4-0001-4001-8001-000000000001" type="reamer" unit="inches" version="1.5">
    <description>0.2500 (1/4) DIA Chucking Reamer, 4 Flutes</description>
