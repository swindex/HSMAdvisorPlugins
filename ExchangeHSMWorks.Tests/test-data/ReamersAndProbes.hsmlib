      <preset description="" id="{11111111-1111-1111-1111-111111111111}" name="Default Preset" tool_coolant="flood" tool_feedCutting="20" tool_feedEntry="20" tool_feedExit="20" tool_feedPlunge="10" tool_feedRamp="10" tool_rampSpindleSpeed="1000" tool_spindleSpeed="1000"/>
    </presets>
