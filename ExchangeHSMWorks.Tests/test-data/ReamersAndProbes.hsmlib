    <product-id>REAMER-0250</product-id>
    <nc break-control="0" diameter-offset="0" length-offset="0" live-tool="1" manual-tool-change="0" number="0" turret="0"/>
    <coolant mode="flood"/>
    <material name="hss"/>
    <body body-length="1.75" coolant-support="no" diameter="0.25" flute-length="1.25" number-of-flutes="4" overall-length="3.5" shaft-diameter="0.25" shoulder-length="1.25" thread-pitch="0" thread-profile-angle="60"/>
    <motion clockwise="yes" cutting-feedrate="20" entry-feedrate="20" exit-feedrate="20" feed-mode="per-minute" plunge-feedrate="10" ramp-feedrate="10" ramp-spindle-rpm="1000" retract-feedrate="0" spindle-rpm="1000"/>
